    "智能识窗或自由框选；支持标注、延迟截图、滚动长图、复制与保存。结果可钉在桌面对照，贴图可拖动、缩放、旋转与穿透。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart window detect or free selection; supports annotation, delayed capture, scrolling long shots, copy, and save. Results can pin to the desktop for reference; pins can be moved, scaled, rotated, and set to click-through."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能识窗或自由框选；支持标注、延迟截图、滚动长图、复制与保存。结果可钉在桌面对照，贴图可拖动、缩放、旋转与穿透。"
          }
        }
      }
    },
